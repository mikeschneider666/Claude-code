<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>de.mikeschneider.ticketradar</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__RADAR_DIR__/ticketradar.py</string>
  </array>
  <key>WorkingDirectory</key><string>__RADAR_DIR__</string>
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__RADAR_DIR__/state/launchd.log</string>
  <key>StandardErrorPath</key><string>__RADAR_DIR__/state/launchd.err</string>
</dict>
</plist>
